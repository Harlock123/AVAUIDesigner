<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AVAUIDesigner.Shell.ViewModels"
             xmlns:c="using:AVAUIDesigner.Shell.Controls"
             xmlns:pe="using:AVAUIDesigner.Shell.Controls.PropertyEditors"
             x:Class="AVAUIDesigner.Shell.Views.PropertyGridView"
             x:DataType="vm:PropertyGridViewModel">
  <UserControl.Resources>
    <pe:PropertyEditorTemplate x:Key="EditorTemplate" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.name">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="6,0,4,0" />
    </Style>
    <Style Selector="TextBlock.name.modified">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Selection header: type + x:Name -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="6,6,6,2" ColumnSpacing="6">
      <TextBlock Text="{Binding SelectionTypeLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
      <c:CommitTextBox Grid.Column="1" Value="{Binding ElementName}" Watermark="(x:Name)"
                       IsEnabled="{Binding SelectedElement, Converter={x:Static ObjectConverters.IsNotNull}}"
                       ToolTip.Tip="{Binding NameError}" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Text="{Binding NameError}" Foreground="#E0453A" Margin="6,0" FontSize="11"
               IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />

    <!-- Toolbar -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*" Margin="6,2" ColumnSpacing="2">
      <ToggleButton IsChecked="{Binding IsCategorized}" ToolTip.Tip="Sort by category" Padding="6,2" Content="☰" />
      <ToggleButton Grid.Column="1" IsChecked="{Binding IsAlphabetical}" ToolTip.Tip="Sort alphabetically" Padding="6,2" Content="A↓Z" />
      <TextBox Grid.Column="2" Text="{Binding SearchText}" Watermark="Search properties" Margin="4,0,0,0" MinHeight="26" />
    </Grid>

    <!-- Description status bar -->
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            Padding="6,4" MinHeight="44">
      <TextBlock Text="{Binding DescriptionText}" TextWrapping="Wrap" FontSize="11" Opacity="0.85" />
    </Border>

    <TabControl SelectedIndex="{Binding SelectedTab}" Padding="0">
      <TabItem Header="Properties" FontSize="13">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <!-- Grid row/column definition editor -->
            <Expander Header="Grid Definitions" IsExpanded="True" Margin="4" HorizontalAlignment="Stretch"
                      IsVisible="{Binding GridEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="6" DataContext="{Binding GridEditor}" x:DataType="vm:GridDefinitionEditorViewModel">
                <c:GridThumbnail RowValues="{Binding RowValues}" ColumnValues="{Binding ColumnValues}" HorizontalAlignment="Center" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="header" Text="Rows" ToolTip.Tip="Row heights" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="+ Row" Command="{Binding AddRowCommand}" Padding="6,1" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GridDefinitionItemViewModel">
                          <Grid ColumnDefinitions="18,*,Auto" Margin="0,1">
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Opacity="0.6" FontSize="11" />
                            <c:CommitTextBox Grid.Column="1" Value="{Binding Value}" MinHeight="22" Padding="3,1"
                                             ToolTip.Tip="*, 2*, Auto or a pixel value" />
                            <Button Grid.Column="2" Content="✕" Command="{Binding DeleteCommand}" Padding="5,0" Margin="2,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="header" Text="Columns" ToolTip.Tip="Column widths" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="+ Col" Command="{Binding AddColumnCommand}" Padding="6,1" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Columns}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GridDefinitionItemViewModel">
                          <Grid ColumnDefinitions="18,*,Auto" Margin="0,1">
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Opacity="0.6" FontSize="11" />
                            <c:CommitTextBox Grid.Column="1" Value="{Binding Value}" MinHeight="22" Padding="3,1"
                                             ToolTip.Tip="*, 2*, Auto or a pixel value" />
                            <Button Grid.Column="2" Content="✕" Command="{Binding DeleteCommand}" Padding="5,0" Margin="2,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Expander>

            <TextBlock Text="Select an element on the design surface." Margin="8" Opacity="0.6"
                       IsVisible="{Binding !HasSelection}" />

            <ItemsControl x:Name="PropertyList" ItemsSource="{Binding VisibleProperties}">
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="vm:PropertyCategoryHeaderViewModel">
                  <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="6,3" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                  </Border>
                </DataTemplate>
                <DataTemplate DataType="vm:PropertyRowViewModel">
                  <Border Classes="row" Padding="0,1">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Reset" Command="{Binding ResetCommand}" />
                        <MenuItem Header="Edit as Text / Set Binding…" Command="{Binding EditTextCommand}" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="0.42*,0.58*,Auto">
                      <TextBlock Classes="name" Classes.modified="{Binding IsModified}" Text="{Binding DisplayName}"
                                 ToolTip.Tip="{Binding Description}" />
                      <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource EditorTemplate}"
                                      HorizontalContentAlignment="Stretch" Margin="0,0,2,0" />
                      <Button Grid.Column="2" Content="↺" Command="{Binding ResetCommand}" Padding="4,0" MinWidth="0"
                              Background="Transparent" BorderThickness="0" ToolTip.Tip="Reset to default"
                              Opacity="{Binding IsModified, Converter={x:Static c:BoolToOpacity.Instance}}"
                              IsHitTestVisible="{Binding IsModified}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Events" FontSize="13" IsEnabled="{Binding HasEvents}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Events}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EventRowViewModel">
                <Border Classes="row" Padding="0,1" ToolTip.Tip="{Binding Description}">
                  <Grid ColumnDefinitions="0.42*,0.58*,Auto">
                    <TextBlock Classes="name" Text="{Binding Name}" />
                    <c:CommitTextBox Grid.Column="1" Value="{Binding HandlerName}" MinHeight="24" Padding="4,2"
                                     Watermark="(double-click to add)" Tag="{Binding}" Classes="eventHandler" />
                    <TextBlock Grid.Column="2" Text="⚠" Foreground="#E0453A" Margin="4,0" VerticalAlignment="Center"
                               IsVisible="{Binding HasError}" ToolTip.Tip="Not a valid C# identifier" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
